// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SessionStatus {
  ACTIVE
  INACTIVE
}

model AcademicSession {
  id        String        @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  status    SessionStatus

  students Student[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Board {
  id          String  @id @default(cuid())
  name        String  @unique
  shortName   String  @unique
  description String?

  classes       Class[]
  subjects      Subject[]
  students      Student[]
  tests         Test[]
  questionBanks QuestionBank[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Class {
  id String @id @default(cuid())

  name String

  boardId String

  board Board @relation(fields: [boardId], references: [id])

  subjects      Subject[]
  teachers      Teacher[]
  students      Student[]
  liveClasses   LiveClass[]
  assignments   Assignment[]
  tests         Test[]
  questionBanks QuestionBank[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subject {
  id String @id @default(cuid())

  name String

  boardId String
  classId String

  board Board @relation(fields: [boardId], references: [id])
  class Class @relation(fields: [classId], references: [id])

  chapters Chapter[]

  teachers Teacher[]

  liveClasses   LiveClass[]
  assignments   Assignment[]
  tests         Test[]
  questionBanks QuestionBank[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, boardId, classId])
}

model Chapter {
  id String @id @default(cuid())

  chapterNo Int

  name String

  description String?

  isPublished Boolean @default(true)

  subjectId String

  subject Subject @relation(fields: [subjectId], references: [id])

  contents      Content[]
  tests         Test[]
  questionBanks QuestionBank[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([chapterNo, subjectId])
}

enum ResourceType {
  PDF
  IMAGE
  VIDEO
  PPT
  EXCEL
  DOC
  ASSIGNMENT
  LINK
}

model Content {
  id String @id @default(cuid())

  title       String
  description String?

  chapterId String

  chapter Chapter @relation(fields: [chapterId], references: [id])

  resources Resource[]

  orderNo Int?

  isPublished Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Resource {
  id String @id @default(cuid())

  title String

  type ResourceType

  fileUrl String?

  youtubeUrl String?

  fileSize Int?

  isPublished Boolean @default(true)

  contentId String

  teacherId String?

  teacher Teacher? @relation(fields: [teacherId], references: [id])

  content Content @relation(fields: [contentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model File {
  id       String  @id @default(cuid())
  fileName String
  fileUrl  String
  fileType String?
  fileSize Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  ADMIN
  TEACHER
  STUDENT
}

model Admin {
  id String @id @default(cuid())

  name String

  email String @unique

  password String

  role UserRole @default(ADMIN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Teacher {
  id String @id @default(cuid())

  name String

  email String @unique

  phone String @unique

  password String

  photo String?

  qualification String?

  experience Int?

  bio String?

  role UserRole @default(TEACHER)

  isActive Boolean @default(true)

  subjects      Subject[]
  classes       Class[]
  students      Student[]
  resources     Resource[]
  assignments   Assignment[]
  attendances   Attendance[]
  tests         Test[]
  liveClasses   LiveClass[]
  questionBanks QuestionBank[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  id String @id @default(cuid())

  studentId String @unique

  role UserRole @default(STUDENT)

  name String

  email String? @unique

  phone String? @unique

  password String

  photo            String?
  photoUpdateCount Int     @default(0)

  gender String?

  dateOfBirth DateTime?

  admissionDate DateTime @default(now())

  guardianName String?

  guardianPhone String?

  address   String?
  teacherId String?

  teacher Teacher? @relation(fields: [teacherId], references: [id])

  isActive Boolean @default(true)

  boardId           String
  classId           String
  academicSessionId String

  board           Board           @relation(fields: [boardId], references: [id])
  class           Class           @relation(fields: [classId], references: [id])
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id])

  submissions  AssignmentSubmission[]
  attendances  Attendance[]
  testAttempts TestAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Assignment {
  id String @id @default(cuid())

  title       String
  description String?

  fileUrl String?

  dueDate DateTime

  maxMarks Int

  teacherId String
  classId   String
  subjectId String

  teacher Teacher @relation(fields: [teacherId], references: [id])

  class Class @relation(fields: [classId], references: [id])

  subject Subject @relation(fields: [subjectId], references: [id])

  submissions AssignmentSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AssignmentSubmission {
  id String @id @default(cuid())

  assignmentId String

  assignment Assignment @relation(fields: [assignmentId], references: [id])

  studentId String

  student Student @relation(fields: [studentId], references: [id])

  fileUrl String?

  remarks String?

  marks Int?

  submittedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

model Attendance {
  id String @id @default(cuid())

  date   DateTime
  status AttendanceStatus

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])

  liveClassId String?
  liveClass   LiveClass? @relation(fields: [liveClassId], references: [id])

  joinedAt DateTime?
  leftAt   DateTime?
  duration Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, liveClassId])
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

model Test {
  id String @id @default(cuid())

  title       String
  description String?

  duration Int

  totalMarks Int

  passingMarks Int @default(0)

  negativeMarks Float @default(0)

  startTime DateTime?

  endTime DateTime?

  isPublished Boolean @default(false)

  shuffleQuestions Boolean @default(false)

  shuffleOptions Boolean @default(false)

  boardId String

  teacherId String

  classId String

  subjectId String

  chapterId String?

  chapter Chapter? @relation(fields: [chapterId], references: [id])

  teacher Teacher @relation(fields: [teacherId], references: [id])

  class Class @relation(fields: [classId], references: [id])

  subject Subject @relation(fields: [subjectId], references: [id])

  board Board @relation(fields: [boardId], references: [id])

  questions Question[]

  attempts TestAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Question {
  id String @id @default(cuid())

  question String

  questionImage String?

  optionA String
  optionB String
  optionC String
  optionD String

  optionAImage String?
  optionBImage String?
  optionCImage String?
  optionDImage String?

  correctAnswer String

  explanation String?

  difficulty DifficultyLevel?

  marks Int @default(1)

  testId String

  test Test @relation(fields: [testId], references: [id])

  answers TestAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TestAttempt {
  id String @id @default(cuid())

  studentId String

  student Student @relation(fields: [studentId], references: [id])

  testId String

  test Test @relation(fields: [testId], references: [id])

  score Int @default(0)

  submittedAt DateTime @default(now())

  answers TestAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TestAnswer {
  id String @id @default(cuid())

  selectedAnswer String

  questionId    String
  testAttemptId String

  question Question @relation(fields: [questionId], references: [id])

  testAttempt TestAttempt @relation(fields: [testAttemptId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum NoticeAudience {
  ALL
  STUDENTS
  TEACHERS
}

model Notice {
  id String @id @default(cuid())

  title       String
  description String

  audience NoticeAudience @default(ALL)

  createdBy   String
  creatorRole String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LiveClass {
  id String @id @default(cuid())

  title       String
  description String?

  startTime DateTime
  endTime   DateTime

  isActive Boolean @default(true)

  teacherId String
  classId   String
  subjectId String

  teacher Teacher @relation(fields: [teacherId], references: [id])

  class Class @relation(fields: [classId], references: [id])

  subject Subject @relation(fields: [subjectId], references: [id])

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  attendances Attendance[]
}

model OTP {
  id String @id @default(cuid())

  email String
  otp   String

  type String

  verified Boolean @default(false)

  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuestionBank {
  id String @id @default(cuid())

  question String

  questionImage String?

  optionA String
  optionB String
  optionC String
  optionD String

  correctAnswer String

  explanation String?

  difficulty DifficultyLevel?

  marks Int @default(1)

  boardId   String
  classId   String
  subjectId String
  chapterId String?

  teacherId String

  board Board @relation(fields: [boardId], references: [id])

  class Class @relation(fields: [classId], references: [id])

  subject Subject @relation(fields: [subjectId], references: [id])

  chapter Chapter? @relation(fields: [chapterId], references: [id])

  teacher Teacher @relation(fields: [teacherId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
